<pre>{{ planets | jsonify }}</pre>

---
layout: layout.liquid
title: Planetary Playing Cards
---

<section class="deck-header">
  <h1>Planetary Playing Cards</h1>
  <p>A CSS-only solar system deck using 11ty, Grid, and ScrollReveal.</p>
</section>

<section class="grid">

  {% include "card.liquid",
    kind: "sun",
    name: planets.sun.name,
    type: planets.sun.type,
    avatarClass: planets.sun.class
  %}

  {% for p in planets.planets %}
    {% include "card.liquid",
      kind: "planet",
      name: p.name,
      au: p.au,
      avatarClass: p.class
    %}
  {% endfor %}

  <article class="card star reveal">
    <div class="starburst" aria-hidden="true"></div>
    <h2 class="card-title">Star</h2>
    <p class="card-line"><span class="label">Class:</span> Main Sequence</p>
  </article>

</section>
